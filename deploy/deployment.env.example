# Copy only to ignored .local/p13-deploy-compose.env; all paths are workspace-local.
P13_SECRET_DIR=./.local/p13-deploy-secrets
P13_FILES_ROOT=./.local/p13-deploy-files
P13_HEALTH_ROOT=./.local/p13-deploy-health
P13_TLS_DIR=./.local/p13-deploy-tls
FILES_WORKER_SECRET=./.local/p13-deploy-secrets/files.json
KNOWLEDGE_WORKER_SECRET=./.local/p13-deploy-secrets/knowledge.json
# Required later: root-approved URL to the existing BGE; never start a second BGE.
KNOWLEDGE_BGE_URL=
