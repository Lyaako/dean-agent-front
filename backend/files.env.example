# API/agent on the host and the worker share this private directory.
FILES_STORAGE_ROOT=.local/files
# Used only by file worker; provision a separate restricted local DB login.
FILES_DATABASE_FILE=.local/p10-files-connection.json
# Compose requires an explicit credential target, e.g. the isolated repro database:
FILES_WORKER_SECRET=./.local/p10-files-repro-connection.json
FILES_PAGE_TIMEOUT=160
FILES_INSPECT_TIMEOUT=30
