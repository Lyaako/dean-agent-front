# Operator and worker use separate privately provisioned connection files.
KNOWLEDGE_DATABASE_FILE=.local/p11-knowledge-operator.json
KNOWLEDGE_TOKEN_FILE=.local/p11-operator-token.txt
KNOWLEDGE_STORAGE_ROOT=.local/files
KNOWLEDGE_BGE_URL=http://127.0.0.1:8087
KNOWLEDGE_QDRANT_URL=http://127.0.0.1:6337
KNOWLEDGE_QDRANT_COLLECTION=deanery_regulations_v1
KNOWLEDGE_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
KNOWLEDGE_VECTOR_TIMEOUT=60
# Worker: Linux file-worker image, backend.knowledge_worker entry point, its own DB file.
# No operator token is mounted into the worker.
