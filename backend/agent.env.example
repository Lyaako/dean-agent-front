# Copy to ignored .local/agent.env. Credentials stay in the private JSON file.
AGENT_DATABASE_FILE=.local/p08-agent-connection.json
AGENT_BASE_URL=http://127.0.0.1:1234/v1
AGENT_MODEL=qwen_qwen3.5-9b
OPENAI_API_KEY=local
AGENT_PROVIDER_TIMEOUT=120
AGENT_RUN_TIMEOUT=300
AGENT_MAX_TOKENS=1536
# Accepted Qwen3.5 Q4_K_M / parallel1, exact native 14-tool host calibration.
AGENT_TEMPERATURE=0.6
AGENT_REASONING_EFFORT=none
AGENT_CONTEXT_WINDOW=20480
AGENT_PROMPT_TOKENS=4483
# Docker host.docker.internal has its own calibration; see deploy/README.md.
AGENT_PROMPT_FINGERPRINT=98f51c179a951cd3f71df5ed12d3a29124f6eb015356e7fd1e71337bf5c8dd9f
